	"nodes":[
		{"id":"442c959b2a280752","type":"text","text":"\n\n```dataviewjs\nconst headers = [\"🚶/🚴\", \"🗒️\", \"⏱️\", \"📅\"]  \n  \nconst pages = dv.pages()  \n.where(b => b.type == \"log\")  \n.where(b => b.ActivityDate >= dv.date(\"2023-10-03\")) \n.sort(b => b.ActivityDate, \"desc\")  \n.map(b => [  \nb.Activity,  \nb.Distance,  \nb.Duration,  \nb.ActivityDate  \n])  \n  \n  \ndv.header(3, \"Activity since October 3, 2023\")  \ndv.table(headers, pages)\n```\n","x":-360,"y":160,"width":840,"height":460},
