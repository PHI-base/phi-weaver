# PHI-Canto Vault .gitignore - Colleague Sharing Configuration
# =============================================================

# OBSIDIAN PERSONAL CONFIGURATIONS
# Exclude all personal workspace and plugin data
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json
.obsidian/starred.json
.obsidian/bookmarks.json

# Plugin directories and data files - EXCLUDE ALL for colleague sharing
.obsidian/plugins/
.obsidian/themes/

# Keep only essential Obsidian settings (community can configure their own)
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/core-plugins-migration.json
!.obsidian/community-plugins.json

# Obsidian plugin-managed personal notes (Daily Notes, etc.) — local-only scratch
__Obsidian-SYSTEM/

# Temporary files and trash
.tmp/
*.tmp
*~
.DS_Store
Thumbs.db
.trash/

# OS generated files
.DS_Store?
ehthumbs.db
Icon?
Desktop.ini

# Editor backup files
*~
*.bak
*.swp
*.swo

# Node modules (if using any plugins with dependencies)
node_modules/

# Python cache (for your reorganizer scripts)
__pycache__/
*.pyc
*.pyo
*.pyd

# Local API-response caches for the lookup helper tools (UniProt, OLS, PHIPO).
# Tools moved from scripts/ into phiweaver/ (P1); keep both paths ignored.
scripts/.cache/
phiweaver/**/.cache/

# Python virtual environment
.venv/
venv/
env/

# Log files
*.log

# AI TOOL CONFIGURATIONS - Personal settings
# SystemSculpt AI plugin and cache files
.systemsculpt/
SystemSculpt/

# Claude memory and cache (contains personal interaction history)
.claude/

# PERSONAL CURATION DATA
# Exclude databases with personal curation progress
11-CLAUDE-AI/db/phi_canto_tracking.db
11-CLAUDE-AI/db/*.db

# Codespaces / local demo literature storage (converted PDFs, media, notes)
demo-literature/
PHI-Canto-Literature/

# Backup files with personal timestamps
.systemsculpt/settings-backups/
11-CLAUDE-AI/SESSION-LOGS/INDEX-backup*.md

# TEMPLATES AND BINARY FILES
# Keep template structure but exclude personal modifications
_Templates/

# Binary files that colleagues should obtain from original sources
*.pdf
*.docx
*.xlsx
*.pptx
# ...but keep the shared benchmarking scorecard (a deliberate team template, not a source file)
!07-Standards/curation-benchmarking/PHI-Weaver-Curation-Scorecard.xlsx

# Media files (colleagues can regenerate via automation)
03-Media/

# COLLEAGUE SHARING - Include these for collaboration
# Session logs provide context (but review for sensitive content)
# 11-CLAUDE-AI/SESSION-LOGS/ - KEEP for continuity
# Automation tools - KEEP for functionality
# Protocol documentation - KEEP for workflows